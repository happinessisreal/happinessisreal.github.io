---
import type { Project } from '../lib';
interface Props { project: Project; }
const { project } = Astro.props;
const { name, summary, tags, year } = project.data;
---
<li>
  <a class="row" href={`/projects/${project.id}`}>
    <img class="logo" src={`/logos/${project.id}.svg`} alt="" width="84" height="84" loading="lazy" />
    <div class="body">
      <h3><span>{name}</span><span class="arrow" aria-hidden="true">→</span></h3>
      <p>{summary}</p>
      <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
    </div>
    <span class="year mono faint">{year}</span>
  </a>
</li>

<style>
  .row {
    display: grid; grid-template-columns: 84px minmax(0, 1fr) auto; gap: 20px; align-items: start;
    padding: 16px; margin-inline: -16px; border-radius: 12px; text-decoration: none;
    transition: background 0.2s ease;
  }
  .row:hover, .row:focus-visible { background: var(--surface); }
  .logo { width: 84px; height: 84px; padding: 10px; object-fit: contain; background: #0d1117; border-radius: 10px; border: 1px solid var(--line); transition: border-color 0.2s ease; }
  .row:hover .logo, .row:focus-visible .logo { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  h3 { font-size: 16px; display: flex; gap: 8px; align-items: baseline; }
  .arrow { color: var(--faint); transition: transform 0.2s ease, color 0.2s ease; }
  .row:hover h3 span:first-child, .row:focus-visible h3 span:first-child { color: var(--accent-ink); }
  .row:hover .arrow, .row:focus-visible .arrow { transform: translateX(4px); color: var(--accent); }
  p { margin: 0; color: var(--muted); font-size: 15px; }
  .tags { margin-top: 4px; }
  .year { font-size: 12.5px; padding-top: 2px; }
  @media (max-width: 520px) { .row { grid-template-columns: 64px minmax(0, 1fr); gap: 16px; } .logo { width: 64px; height: 64px; padding: 7px; } .year { display: none; } }
  @media (prefers-reduced-motion: reduce) { .row, .arrow { transition: none; } }
</style>
