---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PostRow from '../components/PostRow.astro';
import { site } from '../site';
import { projects, writeups } from '../lib';

const allProjects = await projects();
const posts = (await writeups()).slice(0, 6);
const sections = [
  { id: 'about', label: 'about' },
  { id: 'projects', label: 'projects' },
  { id: 'writeups', label: 'writeups' },
  { id: 'activity', label: 'activity' },
];
---
<Base>
  <div class="layout">
    <header class="side">
      <div class="who">
        <a href="/" class="portrait" aria-label={`${site.name}, home`}>
          <img src="/ascii.svg" alt="ASCII portrait of a smiling Pikachu" width="560" height="398" />
        </a>
        <h1>{site.name}</h1>
        <p class="role mono">{site.role}</p>
        <p class="tagline">{site.tagline}</p>
        <nav class="toc" aria-label="Sections">
          <ul>{sections.map((s) => <li><a href={`#${s.id}`} data-section={s.id}><span class="line"></span>{s.label}</a></li>)}</ul>
        </nav>
      </div>
      <ul class="links">{site.links.map((l) => <li><a href={l.href}>{l.label} ↗</a></li>)}</ul>
    </header>

    <main class="content">
      <section id="about" aria-label="About">
        <h2 class="eyebrow sticky">about</h2>
        {site.intro.map((p) => <p class="intro">{p}</p>)}
        {site.now && <p class="now mono"><span>now</span> {site.now}</p>}
      </section>

      <section id="projects" aria-label="Projects">
        <h2 class="eyebrow sticky">projects</h2>
        <ul class="list">{allProjects.map((p) => <ProjectRow project={p} />)}</ul>
      </section>

      <section id="writeups" aria-label="Writeups">
        <h2 class="eyebrow sticky">writeups</h2>
        <ul class="list">{posts.map((p) => <PostRow post={p} />)}</ul>
        <a class="more mono" href="/writeups">all writeups →</a>
      </section>

      <section id="activity" aria-label="Recent activity">
        <h2 class="eyebrow sticky">activity</h2>
        <p class="muted small">Refreshed daily from GitHub.</p>
        <img class="live" src="/live/activity.svg" alt="My most recent public commits" loading="lazy" />
        <img class="live" src="/live/year.svg" alt="The last year of contributions, one character per day" loading="lazy" />
      </section>

      <footer class="foot faint mono">
        Built with Astro, hosted on GitHub Pages. <a href="https://github.com/happinessisreal/happinessisreal.github.io">Source</a>.
      </footer>
    </main>
  </div>
</Base>

<script>
  // Highlight the section currently in view in the left-hand menu.
  const links = [...document.querySelectorAll<HTMLElement>('.toc a')];
  const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
  let ticking = false;
  function update() {
    ticking = false;
    const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
    let current = sections[0];
    for (const s of sections) if (s.getBoundingClientRect().top <= innerHeight * 0.35) current = s;
    if (atBottom) current = sections[sections.length - 1];
    links.forEach((a) => a.classList.toggle('active', a.dataset.section === current.id));
  }
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  update();
</script>

<style>
  .layout {
    position: relative; z-index: 1;
    max-width: 1220px; margin: 0 auto; padding-inline: clamp(20px, 5vw, 64px);
    display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 72px);
  }
  .side {
    position: sticky; top: 0; height: 100vh; max-height: 100vh;
    display: flex; flex-direction: column; justify-content: space-between; gap: 24px;
    padding-block: clamp(48px, 9vh, 96px);
  }
  .who { display: flex; flex-direction: column; gap: 14px; }
  .portrait img { width: min(100%, 520px, calc(42vh * 1.42)); height: auto; }
  h1 { font-size: clamp(30px, 3.4vw, 42px); letter-spacing: -0.02em; margin-top: 8px; }
  .role { color: var(--accent-ink); font-size: 14px; margin: 0; }
  .tagline { color: var(--muted); margin: 0; max-width: 34ch; }
  .toc ul { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-direction: column; gap: 14px; }
  .toc a {
    display: inline-flex; align-items: center; gap: 14px; text-decoration: none; color: var(--faint);
    font: 600 12px/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; transition: color 0.2s ease;
  }
  .toc .line { width: 32px; height: 1px; background: currentColor; transition: width 0.2s ease; }
  .toc a:hover, .toc a.active { color: var(--fg); }
  .toc a:hover .line, .toc a.active .line { width: 64px; }
  .links { list-style: none; padding: 0; margin: 0; display: flex; gap: 18px; font: 13px/1 var(--font-mono); }
  .links a { color: var(--muted); text-decoration: none; }
  .links a:hover { color: var(--accent-ink); }

  .content { padding-block: clamp(48px, 9vh, 96px); display: flex; flex-direction: column; gap: 88px; min-width: 0; }
  section { display: flex; flex-direction: column; gap: 14px; scroll-margin-top: 24px; }
  .sticky { color: var(--faint); margin-bottom: 6px; }
  .intro { margin: 0; color: var(--muted); font-size: 17px; }
  .intro:first-of-type { color: var(--fg); }
  .now { margin: 6px 0 0; font-size: 13.5px; color: var(--muted); }
  .now span { color: var(--accent); font-weight: 700; margin-right: 6px; }
  .list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .more { color: var(--fg); text-decoration: none; font-size: 13.5px; margin-top: 6px; }
  .more:hover { color: var(--accent-ink); }
  .small { font-size: 14px; margin: 0; }
  .live { width: 100%; height: auto; }
  .foot { font-size: 12.5px; }
  .foot a { color: var(--muted); }

  @media (max-width: 1000px) {
    .layout { grid-template-columns: 1fr; gap: 0; }
    .side { position: static; height: auto; max-height: none; padding-bottom: 24px; }
    .portrait img { max-width: 560px; }
    .toc { display: none; }
    .content { padding-top: 24px; gap: 64px; }
    .sticky {
      display: block; position: sticky; top: 0; z-index: 2; margin-inline: calc(-1 * clamp(20px, 5vw, 64px));
      padding: 14px clamp(20px, 5vw, 64px); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px);
    }
  }
</style>
