---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { projects, writeups, type Project } from '../../lib';

export async function getStaticPaths() {
  return (await projects()).map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

interface Props { project: Project; }
const { project } = Astro.props;
const { name, summary, tags, repo, live, shots, year } = project.data;
const { Content } = await render(project);
const related = (await writeups()).filter((w) => w.data.project === project.id);
const [hero, ...rest] = shots;
---
<Base title={name} description={summary}>
  <article class="page">
    <a class="back mono" href="/#projects">← all projects</a>

    <header class="head">
      <img class="logo" src={`/logos/${project.id}.svg`} alt="" width="160" height="160" />
      <div class="title">
        <h1>{name}</h1>
        <p class="summary">{summary}</p>
        <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
        <p class="actions mono">
          <a href={`https://github.com/${repo}`}>source ↗</a>
          {live && <a href={live}>live ↗</a>}
          <span class="faint">{year}</span>
        </p>
      </div>
    </header>

    {hero && (
      <figure class="hero">
        <img src={hero.src} alt={hero.alt} loading="eager" />
        <figcaption class="faint">{hero.alt}</figcaption>
      </figure>
    )}

    <div class="prose"><Content /></div>

    {rest.length > 0 && (
      <section class="gallery" aria-label="More screenshots">
        {rest.map((s) => (
          <figure>
            <a href={s.src}><img src={s.src} alt={s.alt} loading="lazy" /></a>
            <figcaption class="faint">{s.alt}</figcaption>
          </figure>
        ))}
      </section>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2 class="eyebrow">writeups about this</h2>
        <ul class="list">{related.map((p) => <PostRow post={p} />)}</ul>
      </section>
    )}
  </article>
</Base>

<style>
  .page {
    position: relative; z-index: 1; max-width: 980px; margin: 0 auto;
    padding: clamp(32px, 7vh, 72px) clamp(20px, 5vw, 48px) 96px; display: flex; flex-direction: column; gap: 36px;
  }
  .back { font-size: 13px; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--accent-ink); }
  .head { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 28px; align-items: start; }
  .logo { width: 160px; height: 160px; padding: 18px; object-fit: contain; background: #0d1117; border-radius: 14px; border: 1px solid var(--line); }
  .title { display: flex; flex-direction: column; gap: 12px; }
  h1 { font-size: clamp(28px, 4vw, 40px); letter-spacing: -0.02em; }
  .summary { margin: 0; color: var(--muted); font-size: 18px; max-width: 60ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 20px; margin: 4px 0 0; font-size: 14px; }
  .actions a { color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--accent); }
  .actions a:hover { color: var(--accent-ink); }
  figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  figure img { width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); }
  figcaption { font-size: 13px; }
  .prose { align-self: center; width: 100%; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
  .related { display: flex; flex-direction: column; gap: 10px; border-top: 1px solid var(--line); padding-top: 28px; }
  .list { list-style: none; padding: 0; margin: 0; }
  @media (max-width: 640px) {
    .head { grid-template-columns: 1fr; gap: 18px; }
    .logo { width: 112px; height: 112px; padding: 12px; }
  }
</style>
