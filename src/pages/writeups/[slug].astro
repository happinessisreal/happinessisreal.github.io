---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { STAGE, STAGE_LABEL, fmtDate, readingTime, projects, writeups, type Writeup } from '../../lib';

export async function getStaticPaths() {
  return (await writeups()).map((w) => ({ params: { slug: w.id }, props: { post: w } }));
}

interface Props { post: Writeup; }
const { post } = Astro.props;
const { title, summary, date, tags, stage, project } = post.data;
const { Content } = await render(post);
const linked = project ? (await projects()).find((p) => p.id === project) : undefined;
---
<Base title={title} description={summary}>
  <article class="page">
    <a class="back mono" href="/writeups">← all writeups</a>
    <header class="head">
      <p class="meta mono faint">
        <time datetime={date.toISOString()}>{fmtDate(date, 'long')}</time>
        <span>·</span><span>{readingTime(post.body)} read</span>
        <span>·</span><span><span class="stage">{STAGE[stage]}</span> {STAGE_LABEL[stage]}</span>
      </p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
    </header>
    <div class="prose"><Content /></div>
    <footer class="foot mono">
      {linked && <a href={`/projects/${linked.id}`}>the project: {linked.data.name} →</a>}
      <a href="/writeups">more writeups →</a>
    </footer>
  </article>
</Base>

<style>
  .page {
    position: relative; z-index: 1; max-width: 760px; margin: 0 auto;
    padding: clamp(32px, 7vh, 72px) clamp(20px, 5vw, 40px) 96px; display: flex; flex-direction: column; gap: 32px;
  }
  .back { font-size: 13px; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--accent-ink); }
  .head { display: flex; flex-direction: column; gap: 14px; }
  .meta { margin: 0; font-size: 13px; display: flex; flex-wrap: wrap; gap: 8px; }
  h1 { font-size: clamp(28px, 4.4vw, 40px); letter-spacing: -0.02em; }
  .summary { margin: 0; color: var(--muted); font: italic 19px/1.6 var(--font-serif); }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); padding-top: 24px; font-size: 14px; }
  .foot a { color: var(--fg); text-decoration: none; }
  .foot a:hover { color: var(--accent-ink); }
</style>
