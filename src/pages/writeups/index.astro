---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { STAGE, STAGE_LABEL, writeups } from '../../lib';

const posts = await writeups();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---
<Base title="Writeups" description="Notes on how my projects work, and what I learned building them.">
  <div class="page">
    <a class="back mono" href="/">← home</a>
    <header class="head">
      <h1>writeups</h1>
      <p class="muted">How my projects work, and what I learned building them. Each piece is marked by how finished it is:</p>
      <p class="legend mono faint">
        {Object.entries(STAGE).map(([k, g]) => <span><span class="stage">{g}</span> {STAGE_LABEL[k as keyof typeof STAGE]}</span>)}
      </p>
    </header>
    {years.map((y) => (
      <section>
        <h2 class="eyebrow">{y}</h2>
        <ul class="list">{posts.filter((p) => p.data.date.getUTCFullYear() === y).map((p) => <PostRow post={p} />)}</ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .page {
    position: relative; z-index: 1; max-width: 820px; margin: 0 auto;
    padding: clamp(32px, 7vh, 72px) clamp(20px, 5vw, 40px) 96px; display: flex; flex-direction: column; gap: 40px;
  }
  .back { font-size: 13px; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--accent-ink); }
  .head { display: flex; flex-direction: column; gap: 12px; }
  .head p { margin: 0; }
  h1 { font-size: clamp(28px, 4.4vw, 40px); letter-spacing: -0.02em; }
  .legend { display: flex; gap: 20px; font-size: 13px; }
  section { display: flex; flex-direction: column; gap: 8px; }
  .list { list-style: none; padding: 0; margin: 0; }
</style>
